TELEGRAM_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=123456789
TIMEFRAMES=3m,5m
EMA_PERIOD=200
CANDLES=500
MIN_VOLUME_USDT=1000000
CONCURRENCY=8
MARKET_TYPE=swap

# Solo cripto (excluye acciones, indices, petroleo/materias primas, forex y tokens de acciones)
EXCLUDE_NON_CRYPTO=true
# EXCLUDE_BASES=PAXG,XAUT,AAPLX,TSLAX   (opcional: sustituye la lista por defecto)

# Modulo 1: toque EMA200
ENABLE_EMA_TOUCH=true
TOUCH_TOLERANCE_PCT=0.0

# Modulo 2: UT Bot + filtro EMA200
ENABLE_UT_BOT=true
UT_KEY_VALUE=1
UT_ATR_PERIOD=10
UT_HEIKIN_ASHI=false
UT_STRICT_ABOVE=false

# Modulo 3: Radar de candidatas a explotar arriba/abajo
ENABLE_RADAR=true
RADAR_TOP_N=5
RADAR_MIN_SCORE=55
RADAR_MIN_VOTES=3
RADAR_COOLDOWN_SCANS=3
RADAR_EVAL_SCANS=6
RADAR_USE_FUNDING=false
RADAR_FUNDING_EXTREME=0.05

# Resumen diario
REPORT_TZ=Europe/Madrid
REPORT_TIME=23:59
FEE_PCT_ROUNDTRIP=0.1

# ---- Filtros de calidad (NUEVOS) ----
# UT Bot: puntuacion 0-100 (ADX, pendiente EMA200, volumen, distancia a la EMA, vela, cruces recientes, TF superiores, BTC)
UT_MIN_QUALITY=65
UT_MIN_ADX=18
UT_MIN_RVOL=1.0
UT_MIN_EMA_DIST_ATR=0.3
UT_MAX_EMA_DIST_ATR=8
UT_MAX_CANDLE_ATR=3
UT_MAX_FLIPS=4

# Contexto multi-timeframe (EMA9/21 en 3 TF superiores) y BTC
USE_HTF=true
HTF_MIN_ALIGNED=1
USE_BTC_FILTER=true
BTC_BLOCK=false

# Toque EMA200: solo rebotes con mecha, con puntuacion minima (TOUCH_MIN_QUALITY=0 y TOUCH_ONLY_REJECTION=false = comportamiento antiguo)
TOUCH_MIN_QUALITY=60
TOUCH_ONLY_REJECTION=true
TOUCH_MIN_WICK=0.35

# Radar
RADAR_MIN_SCORE=60
RADAR_MIN_RVOL_FIRED=1.3
RADAR_USE_HTF=true
RADAR_HTF_MIN_ALIGNED=1
RADAR_BTC_PENALTY=8
